# Copy this file to .env and run `make`. It adds the database connection URL
# and creates .db-password if needed. Keep both files private.
YOLT_PORT=8485
YOLT_DB_PORT=5489
# YOLT_DATABASE_URL is generated by make.
# YOLT_DATA_DIR=./data

# Compose maps these localhost URLs to its Parakeet and Highlightr services.
# Use addresses reachable from the Yolt container for external services.
YOLT_PARAKEET_URL=http://parakeet-cpu:5092
YOLT_HIGHLIGHTR_URL=http://highlightr-api:8000
# YOLT_PARAKEET_MODEL=parakeet-tdt-0.6b-v3

# Optional Yolt LLM override and speaker inference.
# YOLT_LLM_ENDPOINT=
# YOLT_LLM_MODEL=
# YOLT_LLM_API_KEY=

# Optional semantic search. Set a compatible embeddings endpoint to enable it.
# YOLT_EMBED_URL=
# YOLT_EMBED_MODEL=Qwen/Qwen3-Embedding-8B

# LLM settings for the optional Highlightr container (`make services`).
# LLM_BASE_URL=http://host.docker.internal:8080/v1
# LLM_MODEL=gemma4
# LLM_API_KEY=
